<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TXTReader.Pages.MainPage">

    <Grid>

        <!-- Contenido. La cabecera de marca ("TXT Reader" / "Lector de archivos de texto") se
             quito: repetia el titulo de la barra de navegacion y el de la tarjeta de abrir
             fichero, tres veces lo mismo (nota de autor del 2026-08-01). -->
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="20">

                <!-- Abrir fichero -->
                <Button x:Name="SelectFileBtn"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="55"
                        Clicked="OnSelectFileClicked"
                        HorizontalOptions="Fill" />

                <!-- Recientes -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="25,20" Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   x:Name="RecentFilesLabel"
                                   Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center" />
                            <Image Grid.Column="1"
                                   Source="ic_recent.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Center" />
                        </Grid>

                        <CollectionView x:Name="RecentFilesCollection"
                                        ItemsSource="{Binding RecentFiles}"
                                        HeightRequest="250">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeThickness="0"
                                            Padding="0"
                                            Margin="0,5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid Padding="15,12" ColumnDefinitions="Auto,*,Auto">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRecentFileSelected" />
                                            </Grid.GestureRecognizers>

                                            <Image Grid.Column="0"
                                                   Source="ic_file.png"
                                                   WidthRequest="18"
                                                   HeightRequest="18"
                                                   VerticalOptions="Center" />

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="2"
                                                                 Margin="12,0,0,0"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding FileName}"
                                                       Style="{StaticResource BodyText}"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding LastOpened, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                       Style="{StaticResource HintText}" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   Text="›"
                                                   FontSize="22"
                                                   Style="{StaticResource HintText}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="20" HorizontalOptions="Center">
                                    <Label Text="📂"
                                           FontSize="40"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding NoRecentFilesText}"
                                           Style="{StaticResource HintText}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Acerca de -->
                <Button x:Name="AboutBtn"
                        Style="{StaticResource OutlineButton}"
                        Clicked="OnAboutClicked"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
