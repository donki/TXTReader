<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas de la logica de TXT Reader (constitucion General 8.6). La app es un proyecto MAUI de
       un solo proyecto: aqui se enlazan sus ficheros puros (deteccion de codificacion, recientes,
       resaltado de la busqueda, idiomas con sus .resx) y se compilan para net10.0, sin interfaz ni
       dispositivo. Lo que tocan de MAUI (Preferences, SecureStorage) y el registro en disco
       (MobileLogService) lo sustituyen dobles en memoria de Stubs/: nada se escribe fuera de las
       carpetas temporales de las pruebas. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Mismo espacio de nombres raiz que la app: los .resx enlazados se incrustan con el nombre
         que espera AppResources (TXTReader.Resources.Strings.AppResources). -->
    <RootNamespace>TXTReader</RootNamespace>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit y su runner (Apache-2.0), Microsoft.NET.Test.Sdk y coverlet (MIT): solo para probar, no se distribuyen. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Maui.Storage" />
  </ItemGroup>

  <!-- Codigo de la app que se prueba (enlazado, no copiado). -->
  <ItemGroup>
    <Compile Include="..\Services\EncodingDetectionService.cs" Link="App\Services\EncodingDetectionService.cs" />
    <Compile Include="..\Services\RecentFilesService.cs" Link="App\Services\RecentFilesService.cs" />
    <Compile Include="..\Services\TextHighlighter.cs" Link="App\Services\TextHighlighter.cs" />
    <Compile Include="..\Services\FileIntentService.cs" Link="App\Services\FileIntentService.cs" />
    <Compile Include="..\Services\LocalizationService.cs" Link="App\Services\LocalizationService.cs" />
    <Compile Include="..\Resources\Strings\AppResources.Designer.cs" Link="Resources\Strings\AppResources.Designer.cs" />
    <EmbeddedResource Include="..\Resources\Strings\AppResources.resx" Link="Resources\Strings\AppResources.resx" />
    <EmbeddedResource Include="..\Resources\Strings\AppResources.es.resx" Link="Resources\Strings\AppResources.es.resx" />
  </ItemGroup>

</Project>
